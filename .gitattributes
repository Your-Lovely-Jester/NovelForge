# NF-060: paths that must not leave the private development tree.
# `git archive` / export-ignore keeps saved-page fixtures, internal backlog
# history and local build inputs out of any source bundle. The binary installer
# never contains these paths in the first place; scripts/check-personal-data.sh
# proves the binary has no fixture prose.
scripts/fixtures export-ignore
src-tauri/tests/fixtures export-ignore
docs/SOURCE_PIPELINE_BACKLOG.md export-ignore
docs/measurements export-ignore
.github export-ignore
node_modules export-ignore
dist export-ignore
src-tauri/target export-ignore
scripts/__pycache__ export-ignore

# Patch context is byte-sensitive: a CRLF patch does not apply to the LF
# lncrawl checkout. Never let a Windows clone's autocrlf rewrite these.
*.patch -text
*.sh text eol=lf
