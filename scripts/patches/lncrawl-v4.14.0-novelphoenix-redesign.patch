+            if match:
+                last_page = max(last_page, int(match.group(1)))
+
+        chapters: List[PageSoup] = []
+        seen = set()
+        for page in range(1, last_page + 1):
+            soup = tag if page == 1 else self.scraper.get_soup(f"{base_url}?page={page}")
