+
+
+def parse_chapter_spec(spec: str) -> List[int]:
+    """Parse ``1-20``, ``19,31,82`` or a mixture into unique sorted serials."""
+    serials = set()
+    for chunk in spec.split(","):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        if "-" in chunk:
+            start, _, end = chunk.partition("-")
+            start, end = start.strip(), end.strip()
+            if not (start.isdigit() and end.isdigit()):
+                raise ValueError(f"Invalid chapter range: {chunk}")
+            low, high = sorted((int(start), int(end)))
+            if high - low > 50_000:
+                raise ValueError(f"Chapter range is too large: {chunk}")
+            serials.update(range(low, high + 1))
+        elif chunk.isdigit():
+            serials.add(int(chunk))
+        else:
+            raise ValueError(f"Invalid chapter number: {chunk}")
+    return sorted(serials)
